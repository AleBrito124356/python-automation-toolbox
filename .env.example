# Every script in this toolbox runs without any API key. This file exists only
# for the one optional integration below.

# Optional: webhook URL for 14_uptime_checker.py alert notifications.
# Any endpoint that accepts a JSON POST works: a Slack incoming webhook
# (api.slack.com/messaging/webhooks), a Discord webhook (Server Settings >
# Integrations > Webhooks), or your own endpoint. Leave empty to disable alerts.
UPTIME_WEBHOOK_URL=
